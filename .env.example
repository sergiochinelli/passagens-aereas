APP_NAME="Passagens Aereas API"
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
DB_ECHO=false

SERPAPI_KEY=

# FCM HTTP v1 — duas opcoes (use UMA):
# 1) Arquivo de conta de servico no diretorio do backend (desenvolvimento)
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
# 2) Conteudo JSON da conta de servico em uma linha (producao/Render)
FIREBASE_CREDENTIALS_JSON=
# Opcional: forca o project_id (vazio = lido do JSON da conta de servico)
FIREBASE_PROJECT_ID=

SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_TIMEOUT_SECONDS=30
SERPAPI_HL=pt-br
SERPAPI_GL=br
SERPAPI_MAX_OPTIONS=10

PBKDF2_ITERATIONS=260000
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MISFIRE_GRACE_SECONDS=300
SCHEDULER_MAX_INSTANCES=1
SCHEDULER_COALESCE=true

FCM_V1_ENDPOINT_TEMPLATE=https://fcm.googleapis.com/v1/projects/{project_id}/messages:send
FCM_TIMEOUT_SECONDS=15

CORS_ORIGINS=*
